#include <windows.h>

#define PUREMIRROR_FILE_VERSION        1,0,0,0
#define PUREMIRROR_FILE_VERSION_STRING "1.0.0.0"

#define PUREMIRROR_PRODUCT_VERSION        1,0,0,0
#define PUREMIRROR_PRODUCT_VERSION_STRING "1.0.0"

1 VERSIONINFO
 FILEVERSION     PUREMIRROR_FILE_VERSION
 PRODUCTVERSION  PUREMIRROR_PRODUCT_VERSION
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "PureMirror\0"
            VALUE "FileDescription",  PUREMIRROR_FILE_DESCRIPTION "\0"
            VALUE "FileVersion",      PUREMIRROR_FILE_VERSION_STRING "\0"
            VALUE "InternalName",     PUREMIRROR_INTERNAL_NAME "\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 PureMirror\0"
            VALUE "OriginalFilename", PUREMIRROR_ORIGINAL_FILENAME "\0"
            VALUE "ProductName",      "PureMirror\0"
            VALUE "ProductVersion",   PUREMIRROR_PRODUCT_VERSION_STRING "\0"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
